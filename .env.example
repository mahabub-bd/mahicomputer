# Copy to .env.local and fill in real values.

# Canonical site origin — used for SEO (metadata, Open Graph, robots, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL="https://mahicomputer.vercel.app"

# Database (Neon PostgreSQL) — pooled connection for the app
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection used by Prisma migrate / introspection
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Admin auth
JWT_SECRET="<64-char random hex>"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<initial admin password>"

# EmailJS (contact form email notification; DB is the source of truth)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
